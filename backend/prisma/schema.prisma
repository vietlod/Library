// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  reader
  librarian
  admin
}

enum UserStatus {
  pending
  active
  inactive
}

enum BorrowStatus {
  pending
  borrowed
  returned
  rejected
}

enum ReturnStatus {
  pending
  confirmed
}

enum BookCondition {
  normal
  damaged
  lost
}

enum FineReason {
  late_return
  damaged
  lost
}

enum FineStatus {
  unpaid
  pending_confirmation
  paid
  rejected
}

// ============================================
// MODELS
// ============================================

model Profile {
  id        String     @id @db.Uuid
  name      String     @db.VarChar(50)
  phone     String?    @db.VarChar(20)
  address   String?    @db.VarChar(255)
  role      UserRole   @default(reader)
  status    UserStatus @default(pending)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  borrows Borrow[]
  fines   Fine[]
  returnRequestsConfirmed ReturnRequest[] @relation("ReturnRequestConfirmedBy")

  @@map("profiles")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  books Book[]

  @@map("categories")
}

model Book {
  id             String  @id @default(uuid()) @db.Uuid
  title          String  @db.VarChar(100)
  author         String  @db.VarChar(100)
  publicationYear Int?    @map("publication_year")
  isbn           String? @unique @db.VarChar(17)
  categoryId     String  @map("category_id") @db.Uuid
  description    String  @db.VarChar(255)
  quantity       Int
  available      Int
  borrowed       Int     @default(0)
  borrowCount    Int     @default(0) @map("borrow_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  borrows  Borrow[]

  @@map("books")
}

model Borrow {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  bookId         String       @map("book_id") @db.Uuid
  status         BorrowStatus @default(pending)
  requestDate    DateTime     @default(now()) @map("request_date") @db.Timestamptz(6)
  durationDays   Int          @map("duration_days")
  borrowDate     DateTime?    @map("borrow_date") @db.Timestamptz(6)
  dueDate        DateTime?    @map("due_date") @db.Timestamptz(6)
  returnDate     DateTime?    @map("return_date") @db.Timestamptz(6)
  rejectionReason String?     @map("rejection_reason") @db.Text
  isExtended     Boolean      @default(false) @map("is_extended")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user          Profile         @relation(fields: [userId], references: [id], onDelete: Restrict)
  book          Book            @relation(fields: [bookId], references: [id], onDelete: Restrict)
  returnRequest ReturnRequest?
  fines         Fine[]

  @@map("borrows")
}

model ReturnRequest {
  id            String         @id @default(uuid()) @db.Uuid
  borrowId      String         @unique @map("borrow_id") @db.Uuid
  status        ReturnStatus   @default(pending)
  condition     BookCondition?
  requestDate   DateTime       @default(now()) @map("request_date") @db.Timestamptz(6)
  confirmedDate DateTime?      @map("confirmed_date") @db.Timestamptz(6)
  confirmedBy   String?        @map("confirmed_by") @db.Uuid
  note          String?        @db.VarChar(500)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  borrow       Borrow  @relation(fields: [borrowId], references: [id], onDelete: Restrict)
  confirmedByUser Profile? @relation("ReturnRequestConfirmedBy", fields: [confirmedBy], references: [id], onDelete: SetNull)

  @@map("return_requests")
}

model FineLevel {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(25)
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  fines Fine[]

  @@map("fine_levels")
}

model Fine {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  borrowId        String?    @map("borrow_id") @db.Uuid
  fineLevelId     String?    @map("fine_level_id") @db.Uuid
  reason          FineReason
  amount          Decimal    @db.Decimal(10, 2)
  status          FineStatus @default(unpaid)
  paymentDate     DateTime?  @map("payment_date") @db.Timestamptz(6)
  receiptImageUrl String?    @map("receipt_image_url") @db.Text
  note            String?    @db.VarChar(500)
  rejectionReason String?    @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  user      Profile    @relation(fields: [userId], references: [id], onDelete: Restrict)
  borrow    Borrow?    @relation(fields: [borrowId], references: [id], onDelete: SetNull)
  fineLevel FineLevel? @relation(fields: [fineLevelId], references: [id], onDelete: SetNull)

  @@map("fines")
}
